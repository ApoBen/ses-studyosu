# Örnek profil ayarı. Kopyala: scripts/profil/<profil>.env (uygulama "Yeni Ses" sekmesi bunu otomatik üretir).
AD=ornek_ses
MODEL=ornek_ses
GORUNEN_AD="Örnek Ses"
DOSYA=OrnekSes
KAYNAK="/yol/kayit.wav"                 # kendi sesin veya açık izni olan bir ses
CUMLELER="scripts/profil/ornek_cumleler.txt"
MIN_EPOCH=50
# TOPLAM_EPOCH=100                      # üst sınır (10'un katı); boşsa 200, otomatik durma yine çalışır
# HAZIRLA_MOD=tek                       # tek kişi konuşuyorsa; varsayılan: kume (en baskın konuşmacı)
# ISTENMEYEN=0.0-3.5                    # tek modunda elenecek başka bir sesin bilinen aralığı (sn)
